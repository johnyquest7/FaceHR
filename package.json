{
  "name": "facial-hr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "On-device camera heart rate monitor using remote photoplethysmography (rPPG)",
  "scripts": {
    "postinstall": "node scripts/copy-mediapipe-wasm.mjs",
    "prepare:wasm": "node scripts/copy-mediapipe-wasm.mjs",
    "dev": "vite",
    "dev:https": "vite --host --mode https",
    "prebuild": "node scripts/copy-mediapipe-wasm.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "preview:https": "vite preview --host --mode https",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.18",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
